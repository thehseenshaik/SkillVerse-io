# ============================================================================
# SKILLVERSE ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================
# These values are already in firebase.ts but can be overridden here if needed
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
VITE_APP_NAME=SkillVerse
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API URL (if using custom backend)
VITE_API_URL=http://localhost:3001

# ============================================================================
# AUTHENTICATION SETTINGS
# ============================================================================
# Session timeout in milliseconds (default: 30 minutes)
VITE_SESSION_TIMEOUT=1800000

# Enable/disable remember me functionality
VITE_ENABLE_REMEMBER_ME=true

# Enable/disable auto logout on inactivity
VITE_ENABLE_AUTO_LOGOUT=true

# Rate limiting settings
VITE_RATE_LIMIT_MAX_ATTEMPTS=3
VITE_RATE_LIMIT_WINDOW=900000

# ============================================================================
# EMAIL SETTINGS
# ============================================================================
# Email service provider (sendgrid, mailgun, ses, etc.)
VITE_EMAIL_SERVICE=sendgrid

# Email from address
VITE_EMAIL_FROM=noreply@skillverse.io
VITE_EMAIL_FROM_NAME=SkillVerse

# ============================================================================
# OAUTH PROVIDERS
# ============================================================================
# GitHub OAuth (if using custom OAuth flow)
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_CLIENT_SECRET=your_github_client_secret

# LinkedIn OAuth (future)
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id
VITE_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Apple OAuth (future)
VITE_APPLE_CLIENT_ID=your_apple_client_id
VITE_APPLE_TEAM_ID=your_apple_team_id

# ============================================================================
# ANALYTICS
# ============================================================================
# Google Analytics
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id

# PostHog Analytics (optional)
VITE_POSTHOG_KEY=your_posthog_key
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features
VITE_ENABLE_ONBOARDING=true
VITE_ENABLE_COMMUNITY=false
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_PORTFOLIO=false

# ============================================================================
# STRIPE (for payments - future)
# ============================================================================
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
VITE_STRIPE_SECRET_KEY=your_stripe_secret_key

# ============================================================================
# UPLOAD SETTINGS
# ============================================================================
# Max file size in bytes (default: 10MB)
VITE_MAX_FILE_SIZE=10485760

# Allowed file types
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================================================
# SECURITY
# ============================================================================
# Enable/disable CSP headers
VITE_ENABLE_CSP=true

# Enable/disable rate limiting
VITE_ENABLE_RATE_LIMITING=true

# ============================================================================
# DEVELOPMENT
# ============================================================================
# Enable debug mode
VITE_DEBUG=false

# Enable console logging
VITE_ENABLE_LOGGING=true

# ============================================================================
# AI CONFIGURATION
# ============================================================================
# Google Gemini API Key (Required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection
AI_MODEL=gemini-2.5-flash
AI_MODEL_BACKUP=gemini-2.5-pro

# AI Request Settings
AI_TIMEOUT=30000
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.7
AI_TOP_P=0.9
AI_TOP_K=40

# AI Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_HOUR=100
AI_RATE_LIMIT_PER_DAY=500

# AI Retry Configuration
AI_MAX_RETRIES=3
AI_RETRY_DELAY=1000
AI_RETRY_BACKOFF_MULTIPLIER=2

# AI Safety Settings
AI_ENABLE_SAFETY_FILTERS=true
AI_ENABLE_CONTENT_MODERATION=true
AI_MAX_PROMPT_LENGTH=32000
AI_MAX_RESPONSE_LENGTH=8192

# AI Analytics
AI_ENABLE_ANALYTICS=true
AI_ENABLE_TOKEN_TRACKING=true
AI_ENABLE_COST_ESTIMATION=true
